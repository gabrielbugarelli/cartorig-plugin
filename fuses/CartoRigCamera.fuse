-- CartoRig Camera: separate physical Fusion image effect, shared by map layers upstream.
-- Transform semantics require Studio 20 host evaluation; no generated animation.
FuRegisterClass("CartoRigCamera", CT_Tool, {
  REGS_Name="CartoRig Camera",REGS_Category="CartoRig",REGS_OpIconString="CAM",
  REGS_OpDescription="Shared 2D geographic camera",REG_NoMotionBlurCtrls=true,
  REG_NoBlendCtrls=true,REG_Version=1,
})
function Create()
  self:AddControlPage("Control")
  InLatitude=self:AddInput("Center Latitude (deg)","CenterLatitude",{
    LINKID_DataType="Number",INPID_InputControl="SliderControl",
    INP_Default=0,INP_MinScale=-90,INP_MaxScale=90,
    INP_MinAllowed=-90,INP_MaxAllowed=90
  })
  InLongitude=self:AddInput("Center Longitude (deg)","CenterLongitude",{
    LINKID_DataType="Number",INPID_InputControl="SliderControl",
    INP_Default=0,INP_MinScale=-180,INP_MaxScale=180,
    INP_MinAllowed=-180,INP_MaxAllowed=180
  })
  InZoom=self:AddInput("Zoom","Zoom",{
    LINKID_DataType="Number",INPID_InputControl="SliderControl",
    INP_Default=1,INP_MinScale=0.25,INP_MaxScale=16,
    INP_MinAllowed=0.25,INP_MaxAllowed=64
  })
  InBearing=self:AddInput("Bearing (deg)","Bearing",{
    LINKID_DataType="Number",INPID_InputControl="SliderControl",
    INP_Default=0,INP_MinScale=-180,INP_MaxScale=180,
    INP_MinAllowed=-180,INP_MaxAllowed=180
  })
  -- Explicit target coordinates are edited only in Camera Control. No
  -- automatic geographic search or camera movement occurs when Regions are added.
  InTargetLat=self:AddInput("Focus Target Latitude (deg)","TargetLatitude",{
    LINKID_DataType="Number",INPID_InputControl="SliderControl",
    INP_Default=0,INP_MinScale=-90,INP_MaxScale=90,
    INP_MinAllowed=-90,INP_MaxAllowed=90,
  })
  InTargetLon=self:AddInput("Focus Target Longitude (deg)","TargetLongitude",{
    LINKID_DataType="Number",INPID_InputControl="SliderControl",
    INP_Default=0,INP_MinScale=-180,INP_MaxScale=180,
    INP_MinAllowed=-180,INP_MaxAllowed=180,
  })
  InFocusTarget=self:AddInput("Focus Target (Static)","FocusTarget",{
    LINKID_DataType="Number",INPID_InputControl="ButtonControl",
    INP_DoNotifyChanged=true,INP_InitialNotify=false,INP_External=false,
  })
  -- Location bounds are explicit WGS84 coordinates supplied by the user.
  -- Fitting does not add Region, Label, Route or a Motion preset.
  local function bound(title,id,value,min,max,hidden)
    return self:AddInput(title,id,{
      LINKID_DataType="Number",INPID_InputControl="SliderControl",
      INP_Default=value,INP_MinScale=min,INP_MaxScale=max,
      INP_MinAllowed=min,INP_MaxAllowed=max,
      IC_Visible=not hidden,INP_External=true,
    })
  end
  InLocWest=bound("Location West (deg)","LocationWest",-180,-180,180)
  InLocSouth=bound("Location South (deg)","LocationSouth",-90,-90,90)
  InLocEast=bound("Location East (deg)","LocationEast",180,-180,180)
  InLocNorth=bound("Location North (deg)","LocationNorth",90,-90,90)
  InAspect=bound("Fit Output Aspect Ratio","FitAspect",16/9,0.25,8)
  InFitLocation=self:AddInput("Fit to Location Bounds (Static)","FitToLocation",{
    LINKID_DataType="Number",INPID_InputControl="ButtonControl",
    INP_DoNotifyChanged=true,INP_InitialNotify=false,INP_External=false,
  })
  -- Populated transactionally by NodeFactory from the exact managed Region
  -- bounding boxes. These are not editable editorial geography controls.
  InObjectsPresent=bound("Regions Available","ObjectsPresent",0,0,1,true)
  InObjectsWest=bound("Objects West","ObjectsWest",-180,-180,180,true)
  InObjectsSouth=bound("Objects South","ObjectsSouth",-90,-90,90,true)
  InObjectsEast=bound("Objects East","ObjectsEast",180,-180,180,true)
  InObjectsNorth=bound("Objects North","ObjectsNorth",90,-90,90,true)
  InFitObjects=self:AddInput("Fit to Added Objects (Static)","FitToObjects",{
    LINKID_DataType="Number",INPID_InputControl="ButtonControl",
    INP_DoNotifyChanged=true,INP_InitialNotify=false,INP_External=false,
  })
  InResetPose=self:AddInput("Reset Pose / Fit World","ResetPose",{
    LINKID_DataType="Number",INPID_InputControl="ButtonControl",
    INP_DoNotifyChanged=true,INP_InitialNotify=false,INP_External=false,
  })
  self:AddInput("Equirectangular 2D / WGS84 angular coordinates","SourceInfo",{
    LINKID_DataType="Text",INPID_InputControl="LabelControl",INP_External=false,INP_Passive=true,
  })
  self:AddControlPage("Motion")
  self:AddInput("Camera presets will be added after host camera verification","NoMotion",{
    LINKID_DataType="Text",INPID_InputControl="LabelControl",INP_External=false,INP_Passive=true,
  })
  InImage=self:AddInput("Map Input","Input",{LINKID_DataType="Image",LINK_Main=1})
  OutImage=self:AddOutput("Output","Output",{LINKID_DataType="Image",LINK_Main=1})
end
-- Reset affects only this Camera, never the upstream geographic nodes.
-- SetSource uses the current host time, preserving normal Fusion keyframing.
-- Button actions are explicit edits at the Fusion event time. They do not
-- construct animation or alter any upstream Region/WorldMap.
local function control_number(input,time,label)
  -- Fuse SDK: GetValue requires a Render Request, while NotifyChanged
  -- supplies a numeric frame. GetSource(frame) is the documented event API.
  local raw=input:GetSource(time)
  local n=raw and raw.Value
  if type(n)~="number" or n~=n or n==math.huge or n==-math.huge then
    error("CAMERA_TARGET_INVALID: "..tostring(label))
  end
  return n
end
local function write_pose(lat,lon,zoom,time)
  if lat<-90 or lat>90 or lon<-180 or lon>180 or
     zoom<0.25 or zoom>64 then
    error("CAMERA_TARGET_INVALID: target pose is outside WGS84 or Zoom bounds")
  end
  InLatitude:SetSource(Number(lat),time)
  InLongitude:SetSource(Number(lon),time)
  InZoom:SetSource(Number(zoom),time)
end
local function fit_bounds(w,s,e,n,aspect,time)
  if w<-180 or e>180 or s<-90 or n>90 or
     e<=w or n<=s or aspect<0.25 or aspect>8 then
    error("CAMERA_FIT_INVALID: specify nonempty WGS84 bounds without longitude wrapping")
  end
  -- Fit World at Zoom=1 uses min(width/360,height/180) pixels per degree.
  -- The output aspect is explicit because render resolution is not available
  -- in this native Inspector event; no renderer state is inspected.
  local visibleLon=math.max(360,180*aspect)
  local visibleLat=math.max(180,360/aspect)
  local z=math.min(64,math.max(0.25,0.9*math.min(
    visibleLon/(e-w),visibleLat/(n-s))))
  write_pose((s+n)/2,(w+e)/2,z,time)
end
function NotifyChanged(inp,param,time)
  if inp==InResetPose then
    InLatitude:SetSource(Number(0),time)
    InLongitude:SetSource(Number(0),time)
    InZoom:SetSource(Number(1),time)
    InBearing:SetSource(Number(0),time)
  elseif inp==InFocusTarget then
    local lat=control_number(InTargetLat,time,"TargetLatitude")
    local lon=control_number(InTargetLon,time,"TargetLongitude")
    local z=control_number(InZoom,time,"Zoom")
    write_pose(lat,lon,z,time)
  elseif inp==InFitLocation or inp==InFitObjects then
    if inp==InFitObjects and control_number(InObjectsPresent,time,"ObjectsPresent")<0.5 then
      error("CAMERA_FIT_UNAVAILABLE: no managed Country/State bounds to fit")
    end
    local prefix=inp==InFitObjects and "Objects" or "Location"
    local controls=inp==InFitObjects and
      {InObjectsWest,InObjectsSouth,InObjectsEast,InObjectsNorth} or
      {InLocWest,InLocSouth,InLocEast,InLocNorth}
    local b={}
    for i,key in ipairs({"West","South","East","North"}) do
      b[i]=control_number(controls[i],time,prefix..key)
    end
    local aspect=control_number(InAspect,time,"FitAspect")
    fit_bounds(b[1],b[2],b[3],b[4],aspect,time)
  end
end

local function num(input,req)
  local result=input:GetValue(req)
  if not result or type(result.Value)~="number" then error("Camera control unavailable") end
  return result.Value
end
function Process(req)
  local img=InImage:GetValue(req)
  if not img then error("CAMERA_INPUT_MISSING: shared map input is not connected") end
  local lat=num(InLatitude,req)
  local lon=num(InLongitude,req)
  local zoom=num(InZoom,req)
  local bearing=num(InBearing,req)
  if lat~=lat or lon~=lon or zoom~=zoom or bearing~=bearing or
     lat < -90 or lat>90 or zoom<0.25 or zoom>64 or
     bearing<-180 or bearing>180 then
    error("CAMERA_INVALID_POSE: control out of range")
  end
  -- The WorldMap renders a Fit World equirectangular image before this effect.
  -- Pixels of longitude/latitude are scaled by min(width/360,height/180).
  local w,h=img.Width,img.Height
  local fit=math.min(w/360,h/180)
  lon=((lon+180)%360)-180
  local x=0.5-lon*fit/w*zoom
  local y=0.5-lat*fit/h*zoom
  local out=img:Transform(nil,{
    XF_XOffset=x,XF_YOffset=y,XF_XAxis=0.5,XF_YAxis=0.5,
    XF_XSize=zoom,XF_YSize=zoom,XF_Angle=-bearing,
    XF_EdgeMode="Black",
  })
  if not out then error("CAMERA_RENDER_FAILED: Fusion returned no image") end
  OutImage:Set(req,out)
end
